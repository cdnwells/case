EXPO_PUBLIC_CASE_HUB_URL=https://cdnwell.store
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_CASE_REALTIME_URL=https://case-realtime.example.workers.dev
# A broker-specific app credential. Never put OPENAI_API_KEY in the app.
EXPO_PUBLIC_CASE_REALTIME_TOKEN=
# Set this to the same stable fallback token as the hub's CASE_HUB_TOKEN.
CASE_HUB_BOOTSTRAP_TOKEN=
